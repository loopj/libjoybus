id: libjoybus
label: libjoybus
package: "ext-comp"
description: >
  Implementation of the Joybus protocol used by N64 and GameCube controllers.
category: External
quality: production

requires:
  - name: emlib
  - name: dmadrv
  - name: sleeptimer

provides:
  - name: libjoybus

include:
  - path: include

source:
  - path: src/bus.c
  - path: src/checksum.c
  - path: src/n64_pak_fs.c
  - path: src/backend/gecko_sdk/joybus.c
  - path: src/host/common.c
  - path: src/host/gcn.c
  - path: src/host/n64.c
  - path: src/host/n64_pak_rumble.c
  - path: src/target/gcn_controller.c
  - path: src/target/n64_controller.c
  - path: src/target/n64_pak_controller.c
  - path: src/target/n64_pak_rumble.c
  - path: src/target/pixelfx_gameid.c
